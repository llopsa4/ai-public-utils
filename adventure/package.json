{
  "name": "cinderfold",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "art": "node art/pixelate.mjs && node art/rig.mjs && node art/icons.mjs",
    "pixelate": "node art/pixelate.mjs",
    "rig": "node art/rig.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && node scripts/publish.mjs && node scripts/verify-build.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "upng-js": "2.1.0",
    "vite": "8.3.5"
  }
}
