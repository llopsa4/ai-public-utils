{
  "name": "cinderfold",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "art": "node art/pixelate.mjs && node art/tent.mjs && node art/battle.mjs && node art/kc.mjs && node art/rig.mjs && node art/icons.mjs && node art/webp.mjs",
    "webp": "node art/webp.mjs",
    "pixelate": "node art/pixelate.mjs",
    "rig": "node art/rig.mjs",
    "art:check": "tsx scripts/art-check.ts",
    "art:guide": "tsx scripts/art-guide.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && node scripts/publish.mjs && node scripts/verify-build.mjs",
    "preview": "node scripts/serve.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "e2e": "npm run build && playwright test",
    "art:briefs": "tsx scripts/art-briefs.ts",
    "art:import": "node art/import.mjs"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/zilla-slab": "5.3.0",
    "phaser": "3.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pngjs": "7.0.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "upng-js": "2.1.0",
    "vite": "8.3.5"
  }
}
