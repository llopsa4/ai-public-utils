!/adventure/private/kofi1/README.md
!/adventure/private/kofi1/spec.json
!/adventure/private/kofi1/reference/
/FFCardGame/PLAN.md
/FFCardGame/local/
/FFCardGame/dist/
/FFCardGame/AGENTS.md

# Assistant state stays local (including the shared memory in /.agents/memory/); only each game's
# skill entrypoints are versioned.
/.agents/
/adventure/.agents/*
!/adventure/.agents/skills/
/adventure/.agents/skills/*
!/adventure/.agents/skills/adventure-content/
/adventure/.agents/skills/adventure-content/*
